[
  {
    "repository": "Fidge123/my-project",
    "on": "push",
    "commands": [
      {
        "command": "git pull",
        "cwd": "/home/Fidge123/my-project",
        "timeout": 1
      },
      {
        "command": "yarn install",
        "cwd": "/home/Fidge123/my-project/backend",
        "timeout": 1
      },
      {
        "command": "yarn build",
        "cwd": "/home/Fidge123/my-project/backend",
        "timeout": 5
      },
      {
        "command": "pm2 restart backend",
        "cwd": "/home/Fidge123/my-project/backend",
        "timeout": 1
      }
    ]
  },
  {
    "repository": "Fidge123/my-project",
    "on": "workflow_run.completed",
    "commands": [
      {
        "command": "downloadArtifact",
        "cwd": "/home/Fidge123/my-project/frontend",
        "timeout": 1
      },
      {
        "command": "unzip build.zip -d unzipped && rm build.zip && rm -rf build && mv unzipped build",
        "cwd": "/home/Fidge123/my-project/frontend",
        "timeout": 1
      }
    ],
    "workflow": "CI",
    "artifact": "build"
  }
]
